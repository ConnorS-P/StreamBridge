<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.streambridge" name="StreamBridge" version="0.1.8" provider-name="ConnorS-P">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
        <import addon="script.module.streambridge" version="0.1.8"/>
        <import addon="script.module.routing" version="0.2.3"/>
        <import addon="script.module.requests" version="2.31.0"/>
        <import addon="script.module.inputstreamhelper" version="0.6.1" optional="true"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Kodi-native subscription streaming library &amp; source-direct player</summary>
        <description lang="en_GB">Integrates subscription streaming services (starting with Netflix) into Kodi's native library via stable .strm/.nfo projections and launches authorized playback via StreamBridge.Player or platform-native fallbacks.</description>
        <platform>all</platform>
        <license>MIT</license>
        <source>https://github.com/ConnorS-P/StreamBridge</source>
    </extension>
</addon>
